# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit a real .env file.
# ---------------------------------------------------------------------------

# Flask session signing key — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Database (SQLite by default). For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/hostel
DATABASE_URL=sqlite:///instance/hostel.db

# Session / cookie hardening
SESSION_MINUTES=120
SESSION_COOKIE_SECURE=false      # set true when served over HTTPS
WTF_CSRF_ENABLED=true

# Hostel defaults used on first run
HOSTEL_NAME=Ujjwal Hostel
STUDENT_SELF_REGISTRATION=true
ITEMS_PER_PAGE=12

# Development server
PORT=5000
FLASK_DEBUG=1
